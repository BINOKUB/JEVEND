CREATE TABLE jevend_recherches (
    id_recherche INT(11) AUTO_INCREMENT PRIMARY KEY,
    id_utilisateur INT(11) NOT NULL,
    id_categorie INT(11) NOT NULL,
    id_ville INT(11) NOT NULL,
    titre_recherche VARCHAR(100) NOT NULL,
    description TEXT NULL,
    budget_max DECIMAL(10,2) NULL,
    image_reference VARCHAR(255) NULL,
    statut ENUM('actif', 'trouve', 'expire', 'inactif') DEFAULT 'actif',
    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    date_expiration DATETIME NOT NULL,
    FOREIGN KEY (id_utilisateur) REFERENCES jevend_utilisateurs(id_utilisateur) ON DELETE CASCADE,
    FOREIGN KEY (id_categorie) REFERENCES jevend_categories(id_categorie),
    FOREIGN KEY (id_ville) REFERENCES jevend_villes(id_ville)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


CREATE TABLE jevend_reponses_recherche (
    id_reponse INT(11) AUTO_INCREMENT PRIMARY KEY,
    id_recherche INT(11) NOT NULL,
    id_vendeur INT(11) NOT NULL,
    id_annonce_associee INT(11) NULL, -- Si le vendeur a déjà une annonce active
    message_vendeur TEXT NULL,
    date_reponse TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_recherche) REFERENCES jevend_recherches(id_recherche) ON DELETE CASCADE,
    FOREIGN KEY (id_vendeur) REFERENCES jevend_utilisateurs(id_utilisateur) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


